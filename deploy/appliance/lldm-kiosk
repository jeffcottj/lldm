#!/usr/bin/env bash
set -euo pipefail

health_url="${LLDM_KIOSK_HEALTH_URL:-http://127.0.0.1:3210/readyz}"
tv_url="${LLDM_KIOSK_TV_URL:-http://127.0.0.1:3210/tv}"

until curl --fail --silent --show-error --max-time 2 "$health_url" >/dev/null; do
  sleep 2
done

exec chromium \
  --kiosk \
  --no-first-run \
  --disable-session-crashed-bubble \
  --overscroll-history-navigation=0 \
  "$tv_url"
