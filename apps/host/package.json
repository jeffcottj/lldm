{
  "name": "@lldm/host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest --config ../../vitest.config.ts run apps/host/src",
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "@fastify/websocket": "11.3.0",
    "@lldm/content": "workspace:*",
    "@lldm/contracts": "workspace:*",
    "@lldm/providers": "workspace:*",
    "@lldm/runtime": "workspace:*",
    "fastify": "5.11.2",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/node": "24.10.13",
    "@types/qrcode": "1.5.6",
    "tsx": "4.23.11"
  }
}
